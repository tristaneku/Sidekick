{
    "workspace": ["./apps/deamon", "./apps/tui"],

    "tasks": {
      "dev:daemon": "deno task --filter deamon dev",
      "dev:tui": "deno task --filter tui dev",
      "dev": "deno task dev:daemon & deno task dev:tui"
    },

    "lint": {
        "rules": {
            "exclude": ["no-import-prefix"]
        }
    },

    "fmt": {
        "singleQuote": true,
        "lineWidth": 140
    }
}
