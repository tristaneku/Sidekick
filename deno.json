{
    "tasks": {
        "dev": "deno run --watch -A src/main.tsx"
    },
    "imports": {
        "@/": "./src/",
        "ai": "npm:ai@6.0.146",
        "zod": "npm:zod@4.3.6",
        "react": "npm:react@18",
        "types/react": "npm:@types/react@18",
        "ink": "jsr:@deno-ink/core"
    },
    "lint": {
        "rules": {
            "exclude": ["no-import-prefix"]
        }
    },
    "fmt": {
        "singleQuote": true,
        "lineWidth": 140
    },
    "compilerOptions": {
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment"
    },

    "unstable": ["kv"]
}
