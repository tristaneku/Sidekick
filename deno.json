{
    "workspace": ["./apps/deamon", "./apps/tui"],

    "tasks": {
        "deamon:dev": "deno task --filter deamon dev",
        "deamon:push": "deno task --filter deamon push",

        "tui:dev": "deno task --filter tui dev",

        "dev": "deno task deamon:dev & deno task tui:dev"
    },

    "lint": {
        "rules": {
            "exclude": ["no-import-prefix"]
        }
    },

    "fmt": {
        "singleQuote": true,
        "lineWidth": 140,
        "indentWidth": 4,
        "semiColons": false
    },

    "nodeModulesDir": "auto"
}
